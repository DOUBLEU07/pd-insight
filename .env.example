# ---------------------------------------------------------------
# PD Insight — environment
# Copy to .env and adjust. Every value here has a working default,
# except MODELS_HOST_DIR which must point at your .keras files.
# ---------------------------------------------------------------

POSTGRES_USER=pdinsight
POSTGRES_PASSWORD=pdinsight
POSTGRES_DB=pdinsight
POSTGRES_PORT=5432

API_PORT=8000
WEB_PORT=3000

# share.ps1 replaces this automatically before publishing a public link.
JWT_SECRET=change-me-in-production

# Only relevant if something calls the API directly on port 8000. The web app
# itself goes through the Next.js proxy, so it is same-origin and needs no CORS.
CORS_ORIGINS=http://localhost:3000

# Needed only for `docker compose --profile domain up -d`, which serves the app
# on your own domain. Create a tunnel in the Cloudflare Zero Trust dashboard
# (Networks -> Tunnels), copy its token, and paste it here.
CLOUDFLARE_TUNNEL_TOKEN=

# Set false to force the deterministic mock engine even when models are present.
ENABLE_ML=true

# Host folder holding the Keras models. The loader accepts both the plain
# names and the "สำเนาของ " (Copy of) prefixed names that came out of Drive:
#   PRPD_2_Only_best.keras
#   PRPD_TF_1_sigmoid_best.keras
#   auto_gap_time_abstract_v1.keras   (CMD FINAL V2 default)
#   auto_gap_time_abstract_v2.keras
MODELS_HOST_DIR=./models

# Which auto-gap regression model to use. CMD FINAL CODE used v1.
AUTO_GAP_MODEL_VERSION=auto_gap_time_abstract_v1

# ---- Seeding (optional) ----
# Path to the Colab result folder used by scripts/seed.py
SEED_SUMMARY_CSV=
SEED_PRPD_DIR=
SEED_TF_DIR=
